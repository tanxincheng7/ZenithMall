<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tanxincheng.zenith</groupId>
        <artifactId>zenith-mall</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>zenith-start</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-common</artifactId>
        </dependency>

        <!-- 会员模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-member</artifactId>
        </dependency>

        <!-- 商品模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-product</artifactId>
        </dependency>

        <!-- 购物车模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-cart</artifactId>
        </dependency>

        <!-- 订单模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-order</artifactId>
        </dependency>

        <!-- 支付模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-payment</artifactId>
        </dependency>

        <!-- 促销模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-promotion</artifactId>
        </dependency>

        <!-- 搜索模块 -->
        <dependency>
            <groupId>com.tanxincheng.zenith</groupId>
            <artifactId>zenith-search</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tanxincheng.zenith.ZenithMallApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
